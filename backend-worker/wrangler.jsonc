{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "classroom-hub-owner-service",
  "main": "worker.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "vars": {
    "CLASSROOM_PUBLIC_FRONTEND_CONNECTED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "classroom-hub-owner",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
