async function providerFetch(url:string,body:any,headers:any){let r:Response;try{r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json',...headers},body:JSON.stringify(body),signal:AbortSignal.timeout(45000)});}catch{throw new HttpError(502,'Provider connection failed. No answer or delivery has been fabricated.');}if(!r.ok)throw new HttpError(502,'Provider returned HTTP '+r.status+'. Check the model, key and quota.');return r.json() as Promise<any>;}
async function processAlerts(){const c=await get('whatsapp',{});if(!c.enabled)return;const result=await db().prepare("SELECT * FROM hub_alerts WHERE state='pending' AND retry<=? ORDER BY retry LIMIT 30").bind(now()).all();const rows=result.results;if(!rows.length)return;if(c.mode==='daily'){const time=new Date().toLocaleTimeString('en-GB',{timeZone:'Asia/Dhaka',hour:'2-digit',minute:'2-digit'});if(time<c.digestTime||await get('last_digest')===day())return;}
 const groups=c.mode==='daily'?[rows]:rows.map((row:any)=>[row]);for(const group of groups){const text=c.mode==='daily'?group.length+' Classroom Hub feedback items awaiting review. Open the private owner inbox.':group[0].summary;try{const answer=await providerFetch('https://graph.facebook.com/'+c.version+'/'+c.phoneId+'/messages',{messaging_product:'whatsapp',to:c.recipient,type:'template',template:{name:c.template,language:{code:c.language||'en_US'},components:[{type:'body',parameters:[{type:'text',text}]}]}},{Authorization:'Bearer '+c.token});const id=answer.messages?.[0]?.id;if(!id)throw Error('No acceptance ID');await db().batch(group.map((row:any)=>db().prepare("UPDATE hub_alerts SET state='accepted',provider_id=? WHERE id=?").bind(id,row.id)));if(c.mode==='daily')await put('last_digest',day());}catch{await db().batch(group.map((row:any)=>db().prepare('UPDATE hub_alerts SET state=?,attempts=?,retry=? WHERE id=?').bind(row.attempts>=3?'failed':'pending',row.attempts+1,now()+Math.min(3600000,60000*2**(row.attempts+1)),row.id)));}}}
async function readBody(req:Request){if(Number(req.headers.get('Content-Length'))>3*1024*1024)throw new HttpError(413,'Maximum request size is 3 MB.');const text=await req.text();if(encoder.encode(text).length>3*1024*1024)throw new HttpError(413,'Maximum request size is 3 MB.');try{const data=JSON.parse(text);if(!data||typeof data!=='object'||Array.isArray(data))throw Error();return data;}catch{throw new HttpError(400,'Use a JSON object.');}}
