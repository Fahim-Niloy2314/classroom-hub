const encoder=new TextEncoder();const now=()=>Date.now();const day=()=>new Date().toLocaleDateString('en-CA',{timeZone:'Asia/Dhaka'});
class HttpError extends Error { constructor(public status:number,message:string){super(message);} }
function db(){if(!(env as any).DB)throw new HttpError(503,'Private storage is unavailable.');return (env as any).DB;}
async function get(key:string,fallback:any=null){const row=await db().prepare('SELECT value FROM hub_state WHERE key=?').bind(key).first();return row?JSON.parse(row.value):fallback;}
async function put(key:string,value:any){await db().prepare('INSERT INTO hub_state(key,value) VALUES(?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value').bind(key,JSON.stringify(value)).run();}
const hex=(buffer:ArrayBuffer)=>Array.from(new Uint8Array(buffer),x=>x.toString(16).padStart(2,'0')).join('');
const unhex=(value:string)=>Uint8Array.from(value.match(/../g)||[],x=>parseInt(x,16));
async function hash(text:string){return hex(await crypto.subtle.digest('SHA-256',encoder.encode(text)));}
async function derive(password:string,salt:string,iterations=100000){const key=await crypto.subtle.importKey('raw',encoder.encode(password),'PBKDF2',false,['deriveBits']);return hex(await crypto.subtle.deriveBits({name:'PBKDF2',hash:'SHA-256',salt:unhex(salt),iterations},key,256));}
async function credential(){
 const saved=await get('owner');if(saved)return saved;
 if(env.CLASSROOM_OWNER_CREDENTIAL){try{const value=JSON.parse(env.CLASSROOM_OWNER_CREDENTIAL);if(/^[a-f0-9]{32}$/.test(value.salt)&&/^[a-f0-9]{64}$/.test(value.hash))return value;}catch{} }
 // Initial password is supplied only through the user's private hosting settings.
 // Persist a salted hash; never put the plaintext password in public content or responses.
 const password=env.CLASSROOM_OWNER_PASSWORD;if(typeof password!=='string'||password.length<12)return null;
 const salt=hex(crypto.getRandomValues(new Uint8Array(16)).buffer);
 const value={salt,hash:await derive(password,salt,600000),algorithm:'PBKDF2-SHA256',iterations:600000};
 await db().prepare('INSERT OR IGNORE INTO hub_state(key,value) VALUES(?,?)').bind('owner',JSON.stringify(value)).run();
 return get('owner');
}
async function passwordMatches(password:string){const c=await credential();if(!c)return false;const value=await derive(password,c.salt,c.iterations||100000);let diff=value.length^String(c.hash).length;for(let i=0;i<value.length;i++)diff|=value.charCodeAt(i)^(String(c.hash).charCodeAt(i)||0);return diff===0;}
async function authorized(req:Request){const token=req.headers.get('Authorization')?.replace(/^Bearer /,'');if(!token)return false;const row=await db().prepare('SELECT expires FROM hub_sessions WHERE token=?').bind(await hash(token)).first();return !!row&&row.expires>now();}
async function requireOwner(req:Request){if(!await authorized(req))throw new HttpError(401,'Owner sign in is required.');}
async function limit(key:string,cap:number,ttl:number){const k=await hash(key);await db().prepare('INSERT INTO hub_limits(key,count,expires) VALUES(?,1,?) ON CONFLICT(key) DO UPDATE SET count=CASE WHEN expires<? THEN 1 ELSE count+1 END,expires=CASE WHEN expires<? THEN excluded.expires ELSE expires END').bind(k,now()+ttl,now(),now()).run();const row=await db().prepare('SELECT count FROM hub_limits WHERE key=?').bind(k).first();if(row.count>cap)throw new HttpError(429,'Request limit reached. Please try again later.');}
function publicClean(value:any):any {if(Array.isArray(value))return value.map(publicClean);if(value&&typeof value==='object')return Object.fromEntries(Object.entries(value).filter(([k])=>!['__proto__','constructor','prototype'].includes(k)&&!/(password|pwdhash|token|secret|api.?key|webhook)/i.test(k)).map(([k,v])=>[k,publicClean(v)]));return value;}
function validatePublic(value:any){if(!value||typeof value!=='object'||Array.isArray(value))throw new HttpError(400,'Invalid public content.');if(Object.keys(value).some(k=>!PUBLIC_KEYS.has(k)))throw new HttpError(400,'Only public content modules can be published.');if(JSON.stringify(publicClean(value))!==JSON.stringify(value))throw new HttpError(400,'Remove private values before publishing.');if(!value.portalSettings||!Array.isArray(value.faculty)||!Array.isArray(value.notices)||!value.routines)throw new HttpError(400,'Public content is incomplete.');return value;}
async function state(){return await get('public',seed);}
async function publicFrontendConnected(req:Request){if(options.sameOrigin===true)return true;try{const response=await fetch('https://fahim-niloy2314.github.io/classroom-hub/backend-config.json?check='+now(),{headers:{'Cache-Control':'no-cache'},signal:AbortSignal.timeout(5000)});if(!response.ok)return false;const config=await response.json() as any;return String(config.apiBase||'').replace(/\/$/,'')===new URL(req.url).origin;}catch{return false;}}
function aiStatus(c:any){return {enabled:c.enabled===true,provider:c.provider||'gemini',model:c.model||'',configured:!!c.keys?.[c.provider],dailyLimit:c.dailyLimit||100,maxOutputTokens:c.maxOutputTokens||1500};}
