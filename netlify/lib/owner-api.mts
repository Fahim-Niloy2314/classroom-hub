 }
 if(path==='ai/chat'){const c=await get('ai',{});if(!c.enabled||!c.keys?.[c.provider])throw new HttpError(503,'Online AI is not connected. Use the official Gemini/ChatGPT app or a personal API key.');const question=String(data.question||'').trim();if(!question||question.length>8000||!Array.isArray(data.history||[])||(data.history||[]).length>8)throw new HttpError(400,'Invalid question or conversation.');const prior=(data.history||[]).map((m:any)=>{if(!['user','assistant'].includes(m.role)||typeof m.text!=='string'||m.text.length>8000)throw new HttpError(400,'Invalid conversation turn.');return {role:m.role,content:m.text};});await limit('ai-minute:'+ip+':'+Math.floor(now()/60000),3,60000);await limit('ai-day:'+day(),c.dailyLimit||100,86400000);const context=(await state()).courseRegistry?.[data.semester]||[];const instruction=String.raw`Answer the actual engineering question carefully. State assumptions and units. Answer in clear Bangla for Bangla questions, otherwise English. Use valid LaTeX: \( ... \) inline, \[ ... \] display. Do not invent facts, sources or academic rules. Private Drive files cannot be read. This curriculum context is owner-maintained, not an official source: `+JSON.stringify(context);const input=[...prior,{role:'user',content:question}];let answer='';if(c.provider==='gemini'){const r=await providerFetch('https://generativelanguage.googleapis.com/v1beta/models/'+c.model+':generateContent',{systemInstruction:{parts:[{text:instruction}]},contents:input.map(m=>({role:m.role==='assistant'?'model':'user',parts:[{text:m.content}]})),generationConfig:{maxOutputTokens:c.maxOutputTokens||1500}},{'x-goog-api-key':c.keys.gemini});answer=(r.candidates?.[0]?.content?.parts||[]).filter((p:any)=>!p.thought).map((p:any)=>p.text||'').join('\n');}else{const r=await providerFetch('https://api.openai.com/v1/responses',{model:c.model,instructions:instruction,input,max_output_tokens:c.maxOutputTokens||1500,store:false},{Authorization:'Bearer '+c.keys.openai});answer=(r.output||[]).filter((o:any)=>o.type==='message').flatMap((o:any)=>(o.content||[]).filter((p:any)=>p.type==='output_text').map((p:any)=>p.text)).join('\n');}if(!answer)throw new HttpError(502,'The provider returned no answer.');return {success:true,answer:answer.slice(0,100000),provider:c.provider,model:c.model};}
 await requireOwner(req);
 if(path==='logout'){const token=req.headers.get('Authorization')?.replace(/^Bearer /,'')||'';await db().prepare('DELETE FROM hub_sessions WHERE token=?').bind(await hash(token)).run();return {success:true};}
 if(path==='owner'){if(!await passwordMatches(String(data.currentPassword||'')))throw new HttpError(401,'The current owner password is required.');if(!Array.isArray(data.emails)||data.emails.length!==2||new Set(data.emails.map((s:any)=>String(s).trim().toLowerCase())).size!==2||data.emails.some((s:any)=>!OWNERS.includes(String(s).trim().toLowerCase())))throw new HttpError(400,'Owner access is fixed to the two owner addresses.');if(data.newPassword){if(typeof data.newPassword!=='string'||data.newPassword.length<12)throw new HttpError(400,'Use at least 12 characters.');const salt=hex(crypto.getRandomValues(new Uint8Array(16)).buffer);await put('owner',{salt,hash:await derive(data.newPassword,salt,600000),algorithm:'PBKDF2-SHA256',iterations:600000});}await db().prepare('DELETE FROM hub_sessions').run();return {success:true,reauthenticate:true};}
 if(path==='publish'){const content=validatePublic(data.payload);await put('snapshot:'+now(),await state());content.lastUpdated=new Date().toISOString();content.version='4.4.0';await put('public',content);return {success:true,revision:content.lastUpdated,publicUrl:new URL('/api/portal',req.url).href,publication:'database',publicFrontendConnected:await publicFrontendConnected(req)};}
 if(path==='submissions/status'){if(!['new','reviewed','resolved','archived'].includes(data.status))throw new HttpError(400,'Invalid status.');const r=await db().prepare('UPDATE hub_inbox SET status=? WHERE id=?').bind(data.status,data.id).run();if(!r.meta.changes)throw new HttpError(404,'Message not found.');return {success:true};}
