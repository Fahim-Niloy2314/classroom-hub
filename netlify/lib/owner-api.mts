async function handle(req:Request){const url=new URL(req.url),origin=req.headers.get('Origin');const allowed=new Set([url.origin]);const headers:Record<string,string>={'Cache-Control':'no-store','X-Content-Type-Options':'nosniff','Referrer-Policy':'no-referrer','Vary':'Origin'};
 const json=(body:any,status=200)=>new Response(JSON.stringify(body),{status,headers:{...headers,'Content-Type':'application/json; charset=utf-8'}});
 if(origin&&!allowed.has(origin))return json({error:'Origin is not allowed.'},403);if(req.method==='OPTIONS')return new Response(null,{status:204,headers});
 try{if(url.pathname==='/portal_sync.json')return json(await state());if(url.pathname.startsWith('/api/'))return json(await api(req,url.pathname.slice(5)));if(options.sameOrigin)throw new HttpError(404,'Not found.');if(req.method!=='GET'&&req.method!=='HEAD')throw new HttpError(405,'Method not allowed.');const path=url.pathname.replace(/^\//,'');if(path==='backend-config.json')return json({apiBase:''});if(path==='portal_sync.json')return json(await state());if(!FILES.has(path))throw new HttpError(404,'Not found.');const response=await fetch('https://fahim-niloy2314.github.io/classroom-hub/'+(path||'index.html')+url.search,{headers:{'Cache-Control':'no-cache'}});return new Response(req.method==='HEAD'?null:response.body,{status:response.status,headers:{...headers,'Content-Type':response.headers.get('Content-Type')||'application/octet-stream'}});}catch(e:any){return json({error:e instanceof HttpError?e.message:'The owner service could not complete the request.'},e instanceof HttpError?e.status:500);}
}
return {fetch:handle};
}
