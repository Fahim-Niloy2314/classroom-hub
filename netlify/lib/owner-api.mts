 if(path==='presence'){if(!/^[a-zA-Z0-9_-]{16,80}$/.test(data.browserId||''))throw new HttpError(400,'Invalid anonymous browser ID.');const route=['home','tools/routine','tools/cv','tools/cgpa','tools/ai','faculty','progress','notices','feedback','help','admin'].includes(data.route)?data.route:'other';await db().prepare('INSERT INTO hub_activity(id,day,seen,route) VALUES(?,?,?,?) ON CONFLICT(id) DO UPDATE SET seen=excluded.seen,route=excluded.route').bind(await hash(day()+':'+data.browserId),day(),now(),route).run();waitUntil(processAlerts());return {success:true};}
