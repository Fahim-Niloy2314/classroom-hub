  if(path==='submissions'){const rows=await db().prepare('SELECT i.*,a.state notification_state FROM hub_inbox i LEFT JOIN hub_alerts a ON a.id=i.id ORDER BY created DESC LIMIT 1000').all();return {success:true,submissions:rows.results.map((r:any)=>({...JSON.parse(r.payload),id:r.id,receiptId:r.id,createdAt:r.created,status:r.status,notificationState:r.notification_state||'disabled'}))};}
  if(path==='backup'){const rows=await db().prepare('SELECT * FROM hub_inbox ORDER BY created').all();return {success:true,backup:{app:'ClassroomHubBackend',version:1,createdAt:new Date().toISOString(),portalSync:await state(),submissions:rows.results.map((r:any)=>({id:r.id,requestId:r.request_id,createdAt:r.created,status:r.status,payload:JSON.parse(r.payload)}))}};}
  throw new HttpError(404,'Unknown endpoint.');
 }
 if(method!=='POST')throw new HttpError(405,'Method not allowed.');const data=await readBody(req);
